---
import { Font } from 'astro:assets';
import IconSprite from '../components/IconSprite.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/img/logo-preadico.svg';
import { company } from '../data/site';
import { defaultLocale, locales, toLocale, useTranslations } from '../i18n';
import { absolutePageUrl, hreflang, type PageId } from '../i18n/routes';
import '../styles/global.css';

interface Props {
  page: PageId;
  title: string;
  description: string;
}

const { page, title, description } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const absolute = (path: string) => new URL(path, Astro.site).href;
const ogLocale = { cs: 'cs_CZ', en: 'en_GB' } as const;

/** Who runs the site, for search engines (schema.org). */
const organizationId = `${absolutePageUrl('index', defaultLocale)}#organization`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: company.name,
      alternateName: company.shortName,
      url: company.web,
      logo: absolute(logo.src),
      email: company.email,
      telephone: company.phoneLabel,
      vatID: company.vatId,
      address: {
        '@type': 'PostalAddress',
        streetAddress: company.address.street,
        addressLocality: company.address.city,
        postalCode: company.address.postalCode,
        addressCountry: company.address.country,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${absolutePageUrl('index', locale)}#website`,
      url: absolutePageUrl('index', locale),
      name: 'W4H – Watch 4 Health',
      inLanguage: hreflang[locale],
      publisher: { '@id': organizationId },
    },
  ],
};
---

<!doctype html>
<html lang={locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="canonical" href={absolutePageUrl(page, locale)} />
    {locales.map((l) => <link rel="alternate" hreflang={hreflang[l]} href={absolutePageUrl(page, l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolutePageUrl(page, defaultLocale)} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="W4H – Watch 4 Health" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={absolutePageUrl(page, locale)} />
    <meta property="og:locale" content={ogLocale[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={absolute(`${base}/og-image.png`)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-serif" preload={[{ style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-sans" preload={[{ subset: 'latin' }]} />
    <script is:inline>document.documentElement.classList.replace('no-js', 'js');</script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <IconSprite />
    <a class="skip-link" href="#obsah">{t.common.skipLink}</a>

    <Header page={page} />

    <main id="obsah" tabindex="-1">
      <slot />
    </main>

    <Footer page={page} />

    <script>
      import { $$, reduceMotion, onScrollFrame } from '../scripts/dom';

      /* Odhalení při scrollu + postupné zpoždění v seznamech */
      function initReveal() {
        $$('[data-stagger]').forEach((list) => {
          $$('[data-reveal]', list).forEach((el, i) => el.style.setProperty('--d', `${i * 90}ms`));
        });
        const els = $$('[data-reveal], [data-steps]');
        if (!('IntersectionObserver' in window) || reduceMotion.matches) {
          els.forEach((el) => el.classList.add('is-in'));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((en) => {
            if (!en.isIntersecting) return;
            en.target.classList.add('is-in');
            io.unobserve(en.target);
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.12 });
        els.forEach((el) => io.observe(el));
      }

      /* Parallax kompozic při scrollu */
      function initParallax() {
        const els = $$('[data-parallax]');
        if (!els.length || reduceMotion.matches) return;
        onScrollFrame(() => {
          const vh = window.innerHeight;
          els.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.bottom < -100 || r.top > vh + 100) return;
            const speed = parseFloat(el.dataset.parallax ?? '') || 0.05;
            const offset = (r.top + r.height / 2 - vh / 2) * -speed;
            el.style.setProperty('--py', `${offset.toFixed(1)}px`);
          });
        });
      }

      initReveal();
      initParallax();
    </script>
  </body>
</html>
