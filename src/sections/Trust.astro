---
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const [firstLine, ...otherLines] = t.trust.departments;
---

<section class="trust" aria-label={t.trust.label}>
  <div class="container">
    <ul class="trust__row" data-stagger>
      {/* Znění certifikace MDR potvrdí klient */}
      <li class="trust__item" data-reveal><span class="trust__mark">MDR</span><span class="trust__text">{t.trust.mdr}</span></li>
      <li class="trust__item" data-reveal><span class="trust__mark">EWS</span><span class="trust__text">{t.trust.ews}</span></li>
      <li class="trust__item" data-reveal><span class="trust__mark">BLE</span><span class="trust__text">{t.trust.ble}</span></li>
      <li class="trust__item trust__item--wide" data-reveal>
        <span class="trust__mark trust__mark--small">{firstLine}{otherLines.map((line) => <><br />{line}</>)}</span><span class="trust__text">{t.trust.departmentsText}</span>
      </li>
    </ul>
  </div>
</section>
