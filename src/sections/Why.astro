---
import Icon, { type IconName } from '../components/Icon.astro';
import Vis from '../components/Vis.astro';
import VisImage from '../components/VisImage.astro';
import watch from '../assets/img/w4h-watch.svg';
import gateway from '../assets/img/w4h-gateway.svg';
import { useTranslations, type Dictionary } from '../i18n';

const t = useTranslations(Astro.currentLocale);

const benefits: { key: keyof Dictionary['why']['benefits']; icon: IconName }[] = [
  { key: 'safety', icon: 'shield' },
  { key: 'quality', icon: 'clipboard' },
  { key: 'efficiency', icon: 'clock' },
  { key: 'versatility', icon: 'home' },
];
---

<section class="section why" id="proc" aria-labelledby="why-title">
  <div class="container split">
    <div class="split__visual">
      <Vis variant="why" animate circle={{ x: 1.85, y: 1.85, w: 96.3, tint: 'ice' }}>
        <VisImage src={watch} alt={t.why.alt.watch} x={-11.85} y={-7.41} w={103.7} />
        <VisImage src={gateway} alt={t.why.alt.gateway} x={36.3} y={46.3} w={70.37} delay="late" />
      </Vis>
    </div>
    <div class="split__copy">
      <p class="eyebrow" data-reveal>{t.why.eyebrow}</p>
      <h2 class="h2" id="why-title" data-reveal>{t.why.title}</h2>
      <p class="lead" data-reveal>{t.why.lead}</p>
      <ul class="benefits" data-stagger>
        {benefits.map(({ key, icon }) => (
          <li class="benefit" data-reveal>
            <span class="icon-disc" style="--c:var(--ice)"><Icon name={icon} /></span>
            <h3 class="benefit__title">{t.why.benefits[key].title}</h3>
            <p class="benefit__text">{t.why.benefits[key].text}</p>
          </li>
        ))}
      </ul>
      <a class="text-link" href="#jak" data-reveal>{t.nav.jak}<Icon name="arrow" /></a>
    </div>
  </div>
</section>
