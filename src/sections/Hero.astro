---
import Icon from '../components/Icon.astro';
import watch from '../assets/img/w4h-watch.svg';
import seal from '../assets/img/seal-mdr-ring.svg';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-enter style="--d:0ms">Watch 4 Health</p>
      <h1 class="hero__title" id="hero-title" data-enter style="--d:80ms">Kontinuální monitoring pacientů</h1>
      <p class="hero__tagline" data-enter style="--d:180ms">Řešení, které se stane standardem</p>
      <p class="hero__lead" data-enter style="--d:260ms">Systém W4H každých 15 minut automaticky měří, zapisuje a vyhodnocuje 4 základní vitální funkce pacienta – a když se jeho stav zhorší, pošle notifikaci sestře nebo lékaři.</p>
      <div class="hero__actions" data-enter style="--d:340ms">
        <a class="btn btn--primary btn--lg" href="#kontakt">Domluvit ukázku</a>
        <a class="play-link" href="#jak">
          <span class="play-link__disc" aria-hidden="true"><Icon name="play" /></span>
          Jak to funguje
        </a>
      </div>
    </div>

    <div class="hero__visual vis vis--hero" data-hero-visual data-enter style="--d:200ms">
      <span class="vis__circle hero__circle" style="--c:var(--ice)" aria-hidden="true"></span>
      <div class="layer hero__watch" style="--depth:.6">
        <img src={watch.src} width={watch.width} height={watch.height} alt="Hodinky W4H s QR kódem na displeji a černým řemínkem" />
      </div>
      <div class="layer hero__seal" style="--depth:1.4">
        <div class="seal"><img src={seal.src} width={seal.width} height={seal.height} alt="" /><span class="seal__text">MDR</span></div>
      </div>
      <div class="layer hero__alert" style="--depth:1.1">
        <div class="alert-card float" role="img" aria-label="Upozornění: Vzorový, Milan, pokoj 4, krevní tlak 89/65 mmHg mimo meze">
          <div class="alert-card__head"><Icon name="alert" />Metrika mimo meze</div>
          <div class="alert-card__body">
            <div class="alert-card__row"><span class="alert-card__name">Vzorový, Milan</span><span class="alert-card__room">Pokoj 4</span></div>
            <div class="vital vital--alert"><span class="vital__tag">KT</span><span class="vital__value">89/65 mmHg</span></div>
          </div>
        </div>
      </div>
      <div class="layer hero__chips" style="--depth:1.3">
        <div class="chip float" style="--f:1.4s"><span class="vital__tag">SpO₂</span><span class="vital__value">97 %</span></div>
        <div class="chip chip--offset float" style="--f:.6s"><span class="vital__tag">ST</span><span class="vital__value">72 tepů/min</span></div>
      </div>
      <div class="layer hero__tchip" style="--depth:.9">
        <div class="chip float" style="--f:2.1s"><span class="vital__tag">T</span><span class="vital__value">36,5 °C</span></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { $, reduceMotion, finePointer, onScrollFrame } from '../scripts/dom';

  /* Pohyb do hloubky: hero se při scrollu zvedá a jemně se naklání podle myši */
  const hero = $('[data-hero-visual]');
  if (hero && !reduceMotion.matches) {
    onScrollFrame(() => {
      const y = Math.min(window.scrollY, window.innerHeight);
      hero.style.setProperty('--sy', (-y * 0.06).toFixed(2));
    });

    if (finePointer.matches) {
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        const mx = ((e.clientX - r.left) / r.width - 0.5) * 14;
        const my = ((e.clientY - r.top) / r.height - 0.5) * 14;
        hero.style.setProperty('--mx', mx.toFixed(2));
        hero.style.setProperty('--my', my.toFixed(2));
      });
      hero.addEventListener('pointerleave', () => {
        hero.style.setProperty('--mx', '0');
        hero.style.setProperty('--my', '0');
      });
    }
  }
</script>
