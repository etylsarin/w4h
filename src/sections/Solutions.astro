---
import Icon from '../components/Icon.astro';
import Vis, { type Tint } from '../components/Vis.astro';
import VisImage from '../components/VisImage.astro';
import ward from '../assets/img/ui-virtual-ward-tablet.svg';
import phone from '../assets/img/ui-patient-app-phone.svg';
import facility from '../assets/img/illustration-care-facility.svg';
import { useTranslations, type Dictionary } from '../i18n';

const t = useTranslations(Astro.currentLocale);

/** Card key doubles as the id of the solution's detail section. */
const solutions: {
  id: keyof Dictionary['solutions']['items'];
  tint: Tint;
  image: { src: ImageMetadata; x: number; y: number; w: number };
}[] = [
  { id: 'hospital', tint: 'ice', image: { src: ward, x: -1.76, y: 20.59, w: 103.53 } },
  { id: 'clinic', tint: 'sand', image: { src: phone, x: 25.88, y: 2.35, w: 50 } },
  { id: 'home', tint: 'blush', image: { src: facility, x: -1.18, y: 5.88, w: 105.88 } },
];
---

<section class="section solutions" id="reseni" aria-labelledby="solutions-title">
  <div class="container">
    <header class="section-head">
      <h2 class="h2" id="solutions-title" data-reveal>{t.solutions.title}</h2>
      <p class="lead" data-reveal>{t.solutions.lead}</p>
    </header>
    <ul class="solution-grid" data-stagger>
      {solutions.map((s) => {
        const item = t.solutions.items[s.id];
        return (
          <li class="solution-card" data-reveal>
            <Vis variant="solution" circle={{ x: 5.88, y: 5.88, w: 88.24, tint: s.tint }}>
              <VisImage {...s.image} alt={item.alt} />
            </Vis>
            <h3 class="solution-card__title">{item.title}</h3>
            <p class="solution-card__text">{item.text}</p>
            <a class="text-link text-link--stretch" href={`#${s.id}`}>{t.solutions.more}<span class="visually-hidden"> {item.title}</span><Icon name="arrow" /></a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
