---
import SolutionDetail from '../components/SolutionDetail.astro';
import Vis from '../components/Vis.astro';
import VisImage from '../components/VisImage.astro';
import ecg from '../assets/img/ui-ecg-report-tablet.svg';
import phone from '../assets/img/ui-patient-app-phone.svg';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const d = t.details.clinic;
---

<SolutionDetail
  id="clinic"
  tag={d.tag}
  title={t.solutions.items.clinic.title}
  lead={d.lead}
  features={d.features}
  tint="sand"
  tagInk="#6B4F07"
  check="var(--ink)"
  reverse
>
  <Vis slot="visual" variant="detail" animate circle={{ x: 3.57, y: 1.85, w: 92.86, tint: 'sand' }}>
    <VisImage src={ecg} alt={d.alt.ecg} x={-7.14} y={12.96} w={107.14} />
    <VisImage src={phone} alt={d.alt.phone} x={71.43} y={41.11} w={30.36} delay="late" />
  </Vis>
  <p class="detail__foot" data-reveal><strong>{d.footLabel}</strong> {d.footText}</p>
</SolutionDetail>
