---
import Icon from '../components/Icon.astro';
import { readings } from '../data/rhythm';
import { format, formatNumber, toLocale, useTranslations } from '../i18n';

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const { tags, units } = t.vitals;
const last = readings.length - 1;
const temperature = (value: number) => formatNumber(value, locale);
---

<section class="section rhythm" id="rytmus" aria-labelledby="rhythm-title">
  <div class="container">
    <div class="rhythm__head">
      <h2 class="h2 h2--rhythm" id="rhythm-title" data-reveal>{t.rhythm.title}</h2>
      <p class="lead" data-reveal>{t.rhythm.lead}</p>
    </div>

    <div class="strip-card" data-rhythm data-reveal>
      <div class="strip-card__top">
        <p class="strip-card__patient"><strong>{t.common.samplePatient}</strong><span>{t.rhythm.patientMeta}</span></p>
        <ul class="legend" aria-label={t.rhythm.legendLabel}>
          <li><span class="dot dot--ok"></span>{t.rhythm.states.ok}</li>
          <li><span class="dot dot--watch"></span>{t.rhythm.states.watch}</li>
          <li><span class="dot dot--alert"></span>{t.rhythm.states.alert}</li>
        </ul>
      </div>
      <div class="strip">
        <ul class="strip__labels" aria-hidden="true">
          <li><span class="vital__tag">{tags.temperature}</span></li>
          <li><span class="vital__tag">{tags.bloodPressure}</span></li>
          <li><span class="vital__tag">{tags.spo2}</span></li>
          <li><span class="vital__tag">{tags.heartRate}</span></li>
        </ul>
        <ol class="strip__cols" aria-label={format(t.rhythm.columnsLabel, { from: readings[0].time, to: readings[last].time })}>
          {readings.map((r, i) => (
            <li class:list={['strip__col', { 'is-last': i === last }]}>
              <button
                type="button"
                aria-label={format(t.rhythm.columnLabel, {
                  time: r.time,
                  temperature: temperature(r.t),
                  bloodPressure: r.kt,
                  state: t.rhythm.states[r.ktState].toLocaleLowerCase(locale),
                  spo2: r.spo2,
                  heartRate: r.st,
                })}
                data-time={r.time}
                data-t={format(units.temperature, { value: temperature(r.t) })}
                data-kt={format(units.bloodPressure, { value: r.kt })}
                data-kt-state={r.ktState}
                data-spo2={format(units.spo2, { value: r.spo2 })}
                data-st={format(units.heartRate, { value: r.st })}
              >
                {['ok', r.ktState, 'ok', 'ok'].map((state, row) => (
                  <span class:list={['sdot', state !== 'ok' && `sdot--${state}`]} style={`--i:${i};--r:${row}`} aria-hidden="true"></span>
                ))}
                <span class:list={['stick', { 'stick--hour': i % 4 === 0 }]} aria-hidden="true"></span>
                <span class="slabel" aria-hidden="true">{i === last || i % 4 === 0 ? r.time : ''}</span>
              </button>
            </li>
          ))}
        </ol>
        <div class="strip__tooltip" data-rhythm-tip data-tags={JSON.stringify(tags)} aria-hidden="true"></div>
        <aside class="callout" aria-live="polite">
          <p class="callout__head"><span class="callout__pulse" aria-hidden="true"></span>{readings[last].time} · {t.common.outOfRange}</p>
          <p class="vital vital--alert vital--lg"><span class="vital__tag">{tags.bloodPressure}</span><span class="vital__value">{format(units.bloodPressure, { value: readings[last].kt })}</span></p>
          <p class="callout__foot"><Icon name="bell" />{t.rhythm.notified}</p>
        </aside>
      </div>
      <div class="strip-card__bottom">
        <p class="strip-card__note">{t.rhythm.note}</p>
        <button type="button" class="ghost-btn" data-rhythm-replay><Icon name="replay" />{t.rhythm.replay}</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { $, $$, reduceMotion } from '../scripts/dom';

  /* Rytmus 15 minut: přehrání a detail sloupce.
     Sloupce se generují při buildu z src/data/rhythm.ts, hodnoty pro tooltip nesou v data-* atributech. */
  const card = $('[data-rhythm]');
  const strip = card && $('.strip', card);
  const tip = card && $('[data-rhythm-tip]', card);
  if (card && strip && tip) {
    const buttons = $$<HTMLButtonElement>('.strip__col button', strip);
    const tags: Record<string, string> = JSON.parse(tip.dataset.tags ?? '{}');

    const row = (label: string, value = '', state?: string) =>
      `<span class="tip__row${state && state !== 'ok' ? ` tip__row--${state}` : ''}"><span>${label}</span><span>${value}</span></span>`;

    function showTip(btn: HTMLButtonElement) {
      const d = btn.dataset;
      tip!.innerHTML = `<span class="tip__time">${d.time}</span>` +
        row(tags.temperature, d.t) + row(tags.bloodPressure, d.kt, d.ktState) + row(tags.spo2, d.spo2) + row(tags.heartRate, d.st);
      const sr = strip!.getBoundingClientRect();
      const br = btn.getBoundingClientRect();
      const half = tip!.offsetWidth / 2;
      let x = br.left - sr.left + br.width / 2;
      x = Math.max(half, Math.min(sr.width - half, x));
      tip!.style.left = `${x}px`;
      tip!.style.top = `${br.top - sr.top - 10}px`;
      tip!.classList.add('is-visible');
    }
    const hideTip = () => tip.classList.remove('is-visible');

    buttons.forEach((btn) => {
      const show = () => showTip(btn);
      btn.addEventListener('mouseenter', show);
      btn.addEventListener('focus', show);
      btn.addEventListener('click', show);
      btn.addEventListener('mouseleave', hideTip);
      btn.addEventListener('blur', hideTip);
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hideTip(); });

    let doneTimer: ReturnType<typeof setTimeout> | undefined;
    function play() {
      clearTimeout(doneTimer);
      strip!.classList.add('is-resetting');
      strip!.classList.remove('is-playing', 'is-done');
      void strip!.offsetWidth; // výchozí stav bez přechodu, pak přechody znovu
      strip!.classList.remove('is-resetting');
      strip!.classList.add('is-playing');
      const total = reduceMotion.matches ? 0 : buttons.length * 55 + 500;
      doneTimer = setTimeout(() => strip!.classList.add('is-done'), total);
    }

    if (!('IntersectionObserver' in window) || reduceMotion.matches) play();
    else {
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { play(); io.disconnect(); }
      }, { threshold: 0.45 });
      io.observe(card);
    }
    $('[data-rhythm-replay]', card)?.addEventListener('click', play);
  }
</script>
