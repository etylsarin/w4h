---
import Vis, { type Tint } from '../components/Vis.astro';
import VisImage from '../components/VisImage.astro';
import watch from '../assets/img/w4h-watch.svg';
import gateway from '../assets/img/w4h-gateway.svg';
import wristband from '../assets/img/patient-id-wristband.svg';
import scanner from '../assets/img/scanner-2d.svg';
import bpMonitor from '../assets/img/ble-blood-pressure-monitor.svg';
import scale from '../assets/img/ble-body-scale.svg';
import { useTranslations, type Dictionary } from '../i18n';

const t = useTranslations(Astro.currentLocale);

type DeviceImage = { src: ImageMetadata; alt: keyof Dictionary['devices']['alt']; x: number; y: number; w: number; delay?: 'late' };

const devices: { key: keyof Dictionary['devices']['items']; tint: Tint; images: DeviceImage[] }[] = [
  { key: 'watch', tint: 'ice', images: [{ src: watch, alt: 'watch', x: -7.69, y: -9.23, w: 115.38 }] },
  { key: 'gateway', tint: 'ice', images: [{ src: gateway, alt: 'gateway', x: -4.62, y: 15.38, w: 109.23 }] },
  {
    key: 'wristband',
    tint: 'ice',
    images: [
      { src: wristband, alt: 'wristband', x: -3.08, y: 36.92, w: 80.77 },
      { src: scanner, alt: 'scanner', x: 45.38, y: 11.54, w: 61.54, delay: 'late' },
    ],
  },
  {
    key: 'ble',
    tint: 'neutral',
    images: [
      { src: bpMonitor, alt: 'bpMonitor', x: -5.38, y: 6.92, w: 88.46 },
      { src: scale, alt: 'scale', x: 36.92, y: 48.46, w: 69.23, delay: 'late' },
    ],
  },
];
---

<section class="section devices" id="zarizeni" aria-labelledby="devices-title">
  <div class="container">
    <header class="section-head">
      <h2 class="h2" id="devices-title" data-reveal>{t.devices.title}</h2>
      <p class="lead" data-reveal>{t.devices.lead}</p>
    </header>
    <ul class="device-grid" data-stagger>
      {devices.map((d) => (
        <li class="device" data-reveal>
          <Vis variant="device" circle={{ x: 3.85, y: 3.85, w: 92.31, tint: d.tint }}>
            {d.images.map((img) => <VisImage {...img} alt={t.devices.alt[img.alt]} />)}
          </Vis>
          <h3 class="device__title">{t.devices.items[d.key].title}</h3>
          <p class="device__text">{t.devices.items[d.key].text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
