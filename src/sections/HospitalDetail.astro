---
import Icon from '../components/Icon.astro';
import SolutionDetail from '../components/SolutionDetail.astro';
import Vis from '../components/Vis.astro';
import VisImage from '../components/VisImage.astro';
import ward from '../assets/img/ui-virtual-ward-tablet.svg';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
const d = t.details.hospital;
---

<SolutionDetail
  id="hospital"
  tag={d.tag}
  title={t.solutions.items.hospital.title}
  lead={d.lead}
  features={d.features}
  tint="ice"
  tagInk="#1B4F8E"
  check="var(--blue)"
>
  <Vis slot="visual" variant="detail" animate circle={{ x: 3.57, y: 1.85, w: 92.86, tint: 'ice' }}>
    <VisImage src={ward} alt={d.alt} x={-5.36} y={17.78} w={110.71} />
    <div class="vis__item vis__item--late vis__chip" style="--x:58.93%;--y:87.04%">
      <div class="note-chip"><span class="note-chip__icon note-chip__icon--alert"><Icon name="bell" /></span><span><strong>{d.notice.title}</strong><small>{d.notice.text}</small></span></div>
    </div>
  </Vis>
  <p class="detail__foot" data-reveal><strong>{d.footLabel}</strong> {d.footText}</p>
</SolutionDetail>
