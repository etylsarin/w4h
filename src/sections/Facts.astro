<section class="facts" aria-label="W4H v číslech">
  <div class="container">
    <dl class="facts__grid" data-reveal>
      <div class="fact">
        <dt class="fact__label">vitální funkce</dt>
        <dd class="fact__value"><span data-count="4">4</span></dd>
      </div>
      <div class="fact fact--center">
        <dt class="fact__label">interval měření</dt>
        <dd class="fact__value"><span data-count="15">15</span><small>min</small></dd>
      </div>
      <div class="fact fact--end">
        <dt class="fact__label">oblasti péče</dt>
        <dd class="fact__value"><span data-count="3">3</span></dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import { $$, reduceMotion } from '../scripts/dom';

  /* Počítadla v řádku s čísly */
  const els = $$('[data-count]');
  if (els.length && !reduceMotion.matches && 'IntersectionObserver' in window) {
    const run = (el: HTMLElement) => {
      const to = parseInt(el.dataset.count ?? '0', 10);
      const dur = 700 + to * 40;
      let start: number | null = null;
      const frame = (t: number) => {
        if (start === null) start = t;
        const p = Math.min(1, (t - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(eased * to));
        if (p < 1) requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };
    els.forEach((el) => { el.textContent = '0'; });
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        run(en.target as HTMLElement);
        io.unobserve(en.target);
      });
    }, { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }
</script>
