---
import Icon from './Icon.astro';
import { nav } from '../data/site';
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href="#top" aria-label="W4H – úvod">
      <Icon name="mark" class="brand__mark" />
      <span class="brand__name">W4H</span>
    </a>

    <nav class="main-nav" aria-label="Hlavní navigace">
      <ul class="main-nav__list">
        {nav.map((item) => <li><a class="nav-link" href={`#${item.id}`} data-spy={item.id}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="lang-switch" role="group" aria-label="Jazyk webu" data-lang-switch>
        <span class="lang-switch__pill" aria-hidden="true"></span>
        <button type="button" class="lang-switch__btn" aria-pressed="true" data-lang="cs">CZ</button>
        <button type="button" class="lang-switch__btn" aria-pressed="false" data-lang="en">EN</button>
      </div>
      <a class="btn btn--primary btn--sm site-header__cta" href="#kontakt">Domluvit ukázku</a>
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="mobilni-menu" data-menu-toggle>
        <span class="visually-hidden" data-menu-label>Otevřít menu</span>
        <Icon name="menu" class="menu-toggle__open" />
        <Icon name="close" class="menu-toggle__close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobilni-menu" data-menu hidden>
    <nav aria-label="Mobilní navigace">
      <ul class="mobile-menu__list">
        {nav.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--primary btn--block" href="#kontakt">Domluvit ukázku</a>
  </div>
</header>

<script>
  import { $, $$ } from '../scripts/dom';

  /* Hlavička: kompaktní stav po odscrollování */
  function initHeader() {
    const header = $('[data-header]');
    if (!header) return;
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  /* Mobilní menu: aria-expanded, Esc, klik mimo, zachycení fokusu */
  function initMenu() {
    const toggle = $('[data-menu-toggle]');
    const menu = $('[data-menu]');
    if (!toggle || !menu) return;
    const label = $('[data-menu-label]', toggle);

    const focusables = () => $$('a[href], button:not([disabled])', menu);

    function open() {
      menu!.hidden = false;
      menu!.classList.add('is-open');
      toggle!.setAttribute('aria-expanded', 'true');
      if (label) label.textContent = 'Zavřít menu';
      focusables()[0]?.focus();
      document.addEventListener('keydown', onKey);
      document.addEventListener('click', onOutside, true);
    }
    function close(returnFocus: boolean) {
      menu!.classList.remove('is-open');
      menu!.hidden = true;
      toggle!.setAttribute('aria-expanded', 'false');
      if (label) label.textContent = 'Otevřít menu';
      document.removeEventListener('keydown', onKey);
      document.removeEventListener('click', onOutside, true);
      if (returnFocus) toggle!.focus();
    }
    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') { close(true); return; }
      if (e.key !== 'Tab') return;
      const items = [toggle!, ...focusables()];
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); items[items.length - 1].focus(); }
      else if (!e.shiftKey && i === items.length - 1) { e.preventDefault(); items[0].focus(); }
    }
    function onOutside(e: MouseEvent) {
      const target = e.target as Node;
      if (!menu!.contains(target) && !toggle!.contains(target)) close(false);
    }

    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') close(true);
      else open();
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) close(false);
    });
    window.matchMedia('(min-width: 961px)').addEventListener('change', (mq) => {
      if (mq.matches && !menu.hidden) close(false);
    });
  }

  /* Přepínač jazyka (CZ / EN)
     Web zatím obsahuje jen českou verzi. Přepínač mění stav a vyšle
     událost „w4h:langchange“ – napojte na ni překlady nebo přesměrování na /en/. */
  function initLang() {
    const group = $('[data-lang-switch]');
    if (!group) return;
    const buttons = $$('[data-lang]', group);
    function set(lang: string, focus = false) {
      buttons.forEach((b) => {
        const on = b.dataset.lang === lang;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (on && focus) b.focus();
      });
      group!.dataset.active = lang;
      document.dispatchEvent(new CustomEvent('w4h:langchange', { detail: { lang } }));
    }
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => set(b.dataset.lang!));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const next = buttons[(i + (e.key === 'ArrowRight' ? 1 : buttons.length - 1)) % buttons.length];
          set(next.dataset.lang!, true);
        }
      });
    });
  }

  /* Scrollspy: zvýrazní položku navigace podle sekce ve výřezu */
  function initScrollspy() {
    const links = $$('[data-spy]');
    if (!links.length || !('IntersectionObserver' in window)) return;
    const groups: Record<string, string[]> = { reseni: ['reseni', 'hospital', 'clinic', 'home'], jak: ['jak', 'rytmus'], zarizeni: ['zarizeni'], kontakt: ['kontakt'] };
    const owner: Record<string, string> = {};
    Object.entries(groups).forEach(([key, ids]) => ids.forEach((id) => { owner[id] = key; }));
    const sections = Object.keys(owner).map((id) => document.getElementById(id)).filter((s): s is HTMLElement => s !== null);
    let current: string | null = null;
    function setActive(key: string | null) {
      if (key === current) return;
      current = key;
      links.forEach((a) => {
        if (a.dataset.spy === key) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    }
    const options = { rootMargin: '-45% 0px -50% 0px' };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) setActive(owner[en.target.id]); });
    }, options);
    sections.forEach((s) => io.observe(s));
    const top = document.getElementById('top');
    if (top) new IntersectionObserver((en) => { if (en[0].isIntersecting) setActive(null); }, options).observe(top);
  }

  initHeader();
  initMenu();
  initLang();
  initScrollspy();
</script>
