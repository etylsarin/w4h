---
import Icon from './Icon.astro';
import logo from '../assets/img/logo-preadico.svg';
import { navIds } from '../data/site';
import { localeLabels, locales, toLocale, useTranslations } from '../i18n';
import { isSolution, pageUrl, type PageId } from '../i18n/routes';

interface Props {
  page: PageId;
}

const { page } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = pageUrl('index', locale);
const onHome = page === 'index';
/** On the home page the menu scrolls to sections; on other pages it leads back to them. */
const sectionHref = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
/** Solution pages have their own demo form at the bottom. */
const demoHref = onHome || isSolution(page) ? '#kontakt' : `${home}#kontakt`;
/** On a solution page, "Řešení" is the current section. */
const isCurrent = (id: string) => (isSolution(page) && id === 'reseni' ? 'true' : undefined);
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a class="brand" href={onHome ? '#top' : home} aria-label={t.header.homeLabel}>
      <img class="brand__logo" src={logo.src} width={logo.width} height={logo.height} alt="" fetchpriority="high" />
    </a>

    <nav class="main-nav" aria-label={t.header.navLabel}>
      <ul class="main-nav__list">
        {navIds.map((id) => (
          <li><a class="nav-link" href={sectionHref(id)} data-spy={onHome ? id : undefined} aria-current={isCurrent(id)}>{t.nav[id]}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <nav class="lang-switch" aria-label={t.header.languageLabel} data-lang-switch data-active={locale}>
        <span class="lang-switch__pill" aria-hidden="true"></span>
        {locales.map((l) => (
          <a
            class="lang-switch__btn"
            href={pageUrl(page, l)}
            hreflang={l}
            lang={l}
            title={localeLabels[l].name}
            aria-current={l === locale ? 'true' : undefined}
          >{localeLabels[l].short}</a>
        ))}
      </nav>
      <a class="btn btn--primary btn--sm site-header__cta" href={demoHref}>{t.common.bookDemo}</a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobilni-menu"
        data-menu-toggle
        data-label-open={t.header.menuOpen}
        data-label-close={t.header.menuClose}
      >
        <span class="visually-hidden" data-menu-label>{t.header.menuOpen}</span>
        <Icon name="menu" class="menu-toggle__open" />
        <Icon name="close" class="menu-toggle__close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobilni-menu" data-menu hidden>
    <nav aria-label={t.header.mobileNavLabel}>
      <ul class="mobile-menu__list">
        {navIds.map((id) => <li><a href={sectionHref(id)} aria-current={isCurrent(id)}>{t.nav[id]}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--primary btn--block" href={demoHref}>{t.common.bookDemo}</a>
  </div>
</header>

<script>
  import { $, $$ } from '../scripts/dom';

  /* Hlavička: kompaktní stav po odscrollování */
  function initHeader() {
    const header = $('[data-header]');
    if (!header) return;
    const update = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }

  /* Mobilní menu: aria-expanded, Esc, klik mimo, zachycení fokusu */
  function initMenu() {
    const toggle = $('[data-menu-toggle]');
    const menu = $('[data-menu]');
    if (!toggle || !menu) return;
    const label = $('[data-menu-label]', toggle);

    const focusables = () => $$('a[href], button:not([disabled])', menu);

    function open() {
      menu!.hidden = false;
      menu!.classList.add('is-open');
      toggle!.setAttribute('aria-expanded', 'true');
      if (label) label.textContent = toggle!.dataset.labelClose ?? '';
      focusables()[0]?.focus();
      document.addEventListener('keydown', onKey);
      document.addEventListener('click', onOutside, true);
    }
    function close(returnFocus: boolean) {
      menu!.classList.remove('is-open');
      menu!.hidden = true;
      toggle!.setAttribute('aria-expanded', 'false');
      if (label) label.textContent = toggle!.dataset.labelOpen ?? '';
      document.removeEventListener('keydown', onKey);
      document.removeEventListener('click', onOutside, true);
      if (returnFocus) toggle!.focus();
    }
    function onKey(e: KeyboardEvent) {
      if (e.key === 'Escape') { close(true); return; }
      if (e.key !== 'Tab') return;
      const items = [toggle!, ...focusables()];
      const i = items.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); items[items.length - 1].focus(); }
      else if (!e.shiftKey && i === items.length - 1) { e.preventDefault(); items[0].focus(); }
    }
    function onOutside(e: MouseEvent) {
      const target = e.target as Node;
      if (!menu!.contains(target) && !toggle!.contains(target)) close(false);
    }

    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') close(true);
      else open();
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) close(false);
    });
    window.matchMedia('(min-width: 961px)').addEventListener('change', (mq) => {
      if (mq.matches && !menu.hidden) close(false);
    });
  }

  /* Přepínač jazyka: odkazy na jazykové verze stránky.
     Pilulka se posune hned po kliknutí a návštěvník zůstane u stejné sekce (#kotva). */
  function initLang() {
    const group = $('[data-lang-switch]');
    if (!group) return;
    group.addEventListener('click', (e) => {
      const link = (e.target as Element).closest<HTMLAnchorElement>('a[hreflang]');
      if (!link) return;
      if (link.getAttribute('aria-current') === 'true') { e.preventDefault(); return; }
      group.dataset.active = link.hreflang;
      if (location.hash) link.hash = location.hash;
    });
  }

  /* Scrollspy (jen na úvodní stránce): zvýrazní položku navigace podle sekce ve výřezu */
  function initScrollspy() {
    const links = $$('[data-spy]');
    if (!links.length || !('IntersectionObserver' in window)) return;
    const groups: Record<string, string[]> = { reseni: ['reseni'], jak: ['jak', 'rytmus'], zarizeni: ['zarizeni'], kontakt: ['kontakt'] };
    const owner: Record<string, string> = {};
    Object.entries(groups).forEach(([key, ids]) => ids.forEach((id) => { owner[id] = key; }));
    const sections = Object.keys(owner).map((id) => document.getElementById(id)).filter((s): s is HTMLElement => s !== null);
    let current: string | null = null;
    function setActive(key: string | null) {
      if (key === current) return;
      current = key;
      links.forEach((a) => {
        if (a.dataset.spy === key) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    }
    const options = { rootMargin: '-45% 0px -50% 0px' };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) setActive(owner[en.target.id]); });
    }, options);
    sections.forEach((s) => io.observe(s));
    const top = document.getElementById('top');
    if (top) new IntersectionObserver((en) => { if (en[0].isIntersecting) setActive(null); }, options).observe(top);
  }

  initHeader();
  initMenu();
  initLang();
  initScrollspy();
</script>
