---
/**
 * Top of a solution page: illustration (slot "visual") next to a breadcrumb, tag,
 * page heading, lead and a list of features. The default slot closes the column.
 */
import Breadcrumb from './Breadcrumb.astro';
import Icon from './Icon.astro';
import type { Tint } from './Vis.astro';
import { toLocale, useTranslations } from '../i18n';
import { pageUrl } from '../i18n/routes';

interface Props {
  id: string;
  tag: string;
  title: string;
  lead: string;
  features: { title: string; text: string }[];
  /** Background of the tag and check discs. */
  tint: Tint;
  /** Text colour of the tag. */
  tagInk: string;
  /** Colour of the check marks. */
  check: string;
  /** Illustration on the right. */
  reverse?: boolean;
  /** Features in one column instead of two. */
  single?: boolean;
}

const { id, tag, title, lead, features, tint, tagInk, check, reverse = false, single = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const home = pageUrl('index', locale);
---

<section
  class:list={['section detail', { 'detail--reverse': reverse }]}
  id={id}
  aria-labelledby={`${id}-title`}
  style={`--tint:var(--${tint});--tag-ink:${tagInk};--check:${check}`}
>
  <div class:list={['container split', { 'split--reverse': reverse }]}>
    <div class="split__visual">
      <slot name="visual" />
    </div>
    <div class="split__copy">
      <Breadcrumb items={[{ label: t.breadcrumb.home, href: home }, { label: t.nav.reseni, href: `${home}#reseni` }, { label: title }]} />
      <p class="tag" data-reveal>{tag}</p>
      <h1 class="h2 h2--detail" id={`${id}-title`} data-reveal>{title}</h1>
      <p class="lead" data-reveal>{lead}</p>
      <ul class:list={['features', { 'features--single': single }]} data-stagger>
        {features.map((f) => (
          <li class="feature" data-reveal>
            <span class="feature__check"><Icon name="check" /></span>
            <div><h2 class="feature__title">{f.title}</h2><p class="feature__text">{f.text}</p></div>
          </li>
        ))}
      </ul>
      <slot />
    </div>
  </div>
</section>
