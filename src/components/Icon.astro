---
/** Decorative icon from the sprite in IconSprite.astro. */
export type IconName =
  | 'check' | 'chevron' | 'arrow' | 'play' | 'alert' | 'bell' | 'shield' | 'clipboard' | 'clock'
  | 'home' | 'pill' | 'globe' | 'phone' | 'menu' | 'close' | 'replay' | 'error';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} aria-hidden="true"><use href={`#i-${name}`} /></svg>
