---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../sections/Hero.astro';
import Facts from '../sections/Facts.astro';
import Why from '../sections/Why.astro';
import Solutions from '../sections/Solutions.astro';
import HowItWorks from '../sections/HowItWorks.astro';
import Rhythm from '../sections/Rhythm.astro';
import Devices from '../sections/Devices.astro';
import Trust from '../sections/Trust.astro';
import Contact from '../sections/Contact.astro';
import { useTranslations } from '../i18n';

const t = useTranslations(Astro.currentLocale);
---

<BaseLayout page="index" title={t.meta.title} description={t.meta.description}>
  <Hero />
  <Facts />
  <Why />
  <Solutions />
  <HowItWorks />
  <Rhythm />
  <Devices />
  <Trust />
  <Contact />
</BaseLayout>
